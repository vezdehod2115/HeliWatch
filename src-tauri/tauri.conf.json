{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HeliWatch",
  "version": "0.8.2",
  "identifier": "dev.heliwatch.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "HeliWatch",
        "width": 412,
        "height": 892,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 802,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
