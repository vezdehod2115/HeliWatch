{
  "name": "heliwatch",
  "private": true,
  "version": "0.8.1",
  "description": "HeliWatch — совместный просмотр видео с голосом и чатом, Android (Tauri v2)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:dev": "tauri android dev",
    "android:apk": "tauri android build --apk --debug",
    "android:patch": "node scripts/apply-android-patches.mjs",
    "android:doctor": "node scripts/check-android.mjs",
    "icons": "node scripts/icons.mjs",
    "version:set": "node scripts/version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-sql": "2.6.0",
    "@trystero-p2p/mqtt": "0.26.0",
    "@trystero-p2p/torrent": "0.26.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "trystero": "0.26.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.1.7",
    "vitest": "5.1.0"
  }
}
